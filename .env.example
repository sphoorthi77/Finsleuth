# Local MongoDB defaults. Configure your Atlas URI here if using Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=finsleuth
MONGODB_REQUIRE_TRANSACTIONS=false
COOKIE_SECURE=false
DEMO_ENABLED=true

# Optional password recovery; configure with your mail provider.
PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
